# FanchmWrt 纯上游构建配置: JDCloud RE-SS-01 (京东云亚瑟 AX1800 Pro), 无 WiFi
# 用法: 工作流会自动 cp 到 openwrt/.config 然后 make defconfig
# 本地验证: cp config/re-ss-01-nowifi.config openwrt/.config && make defconfig
# 纯上游原则: 不加第三方 feed (无 honk), 主机名/版本名不改动, 内核分区保持上游 6144k,
#             不设 ROOTFS_PARTSIZE 等额外参数, 其余跟随上游默认值
# 有意偏差: 1) 默认 LAN IP 192.168.1.1 -> 192.168.100.1 (scripts/re-ss-01-nowifi.sh 内处理)
#           2) 常用工具包 htop/curl/dnsmasq-full/lsblk/usbutils (见下方"常用工具")
# 注意: WiFi 包在 qualcommax target / ipq60xx 子目标 / re-ss-01 设备定义三处被 Kconfig
#       select 强制选中, 仅靠本配置关不掉, 必须先跑 scripts/re-ss-01-nowifi.sh 打源码补丁

# ===== Target (只编 RE-SS-01 一台机器) =====
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ===== Web 界面 (与旧固件一致: luci-ssl = LuCI(light) + HTTPS) =====
# 不要 Web 界面可删掉这一行, 固件将只保留 SSH
CONFIG_PACKAGE_luci-ssl=y

# ===== 常用工具 (与旧固件对齐; f2fs/ext4 工具上游 target 默认包已带, 不重复) =====
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
# dnsmasq-full 与基础版 dnsmasq 互斥, 必须显式关掉基础版, 否则安装冲突
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y

# ===== 内存优化 (zram 压缩交换, 403MB 内存设备) =====
# kmod-zram 自带依赖 lzo/lzo-rle 压缩模块; lz4 用于更快的压缩算法(可选)
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_zram-swap=y

# ===== 6.18 内核 (26.08/26.11) 有线网卡驱动 =====
# 6.18 的 qualcommax 网卡 = 内核补丁 0953 提供的 EDMA 驱动 (qualcomm,ipq6018-edma),
# target config 默认 "not set" 且无对应 kmod 包, 不显式打开则 eth 口完全不存在
# (26.05/6.12 无此符号, make defconfig 会自动忽略本行, 无副作用)
CONFIG_QCOM_EDMA=y
# PPE 硬件加速 (0952 补丁, qualcomm,ipq6018-ppe): flow offload/ACL/QoS 卸载,
# depends on NET_DSA && QCOM_EDMA, target config 默认 "not set", 不显式打开则无加速
CONFIG_QCOM_80211AX_PPE=y

# ===== 无 WiFi: 显式关闭全部无线组件 (配合 scripts/re-ss-01-nowifi.sh) =====
# 驱动/固件/校准数据
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6010 is not set
# CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01 is not set
# 无线栈/管理工具 (根包移除后本会自动落选, 这里写死兜底)
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_wireless-regdb is not set
